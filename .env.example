# ==============================================================================
# RSSFusion Production & Local Environment Configuration
# Copy this file to `.env.local` for development or configure in your cloud provider
# ==============================================================================

# Application Environment & Base URL
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://rssfusion.yourdomain.com
PORT=3000

# ==============================================================================
# Supabase Database & Authentication Configuration
# Found at: https://supabase.com/dashboard/project/<your-ref>/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres URL for Ingestion Worker & Database Migrations
WORKER_DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ==============================================================================
# Ingestion Worker Parameters
# ==============================================================================
WORKER_POLL_INTERVAL_MS=30000
WORKER_CONCURRENCY=5
WORKER_FETCH_TIMEOUT_MS=15000
WORKER_USER_AGENT=RSSFusionBot/1.0 (+https://rssfusion.yourdomain.com/bot)

# ==============================================================================
# Caching & High-Performance In-Memory Tier (Redis / Upstash)
# Options: 'redis' (production multi-instance) or 'memory' (single node / dev)
# ==============================================================================
CACHE_DRIVER=redis
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
CACHE_TTL_DEFAULT=300

# ==============================================================================
# Transactional Email Service (Resend)
# Used for keyword instant alerts and account notifications
# ==============================================================================
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=RSSFusion Intelligence <alerts@yourdomain.com>

# ==============================================================================
# Backup & Disaster Recovery Storage
# ==============================================================================
BACKUP_RETENTION_COUNT=7
BACKUP_DIR=./backups

# ==============================================================================
# Observability & Monitoring
# ==============================================================================
LOG_LEVEL=info
ENABLE_PROMETHEUS_METRICS=true
