# Next.js Web App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dedicated RSS Background Worker
WORKER_DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
WORKER_POLL_INTERVAL_MS=30000
WORKER_CONCURRENCY=5
WORKER_FETCH_TIMEOUT_MS=15000
WORKER_USER_AGENT=RSSFusionBot/1.0 (+https://github.com/rssfusion/rssfusion)

# Email Notifications (Optional - Resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=RSSFusion Alerts <alerts@yourdomain.com>
